{
  "description": "Verify code changed during a Gvueter Lite Codex turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/verify-code.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording code state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/verify-code.mjs\"",
            "timeout": 250,
            "statusMessage": "Checking changed code"
          }
        ]
      }
    ]
  }
}
