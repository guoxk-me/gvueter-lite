{
  "name": "gvueter-lite",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "analyze": "vite-bundle-visualizer --config vite.config.ts --output dist/stats.html --open false",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "eslint src --fix"
  },
